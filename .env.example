# Get a token from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# Your Telegram user ID(s), comma separated. Message the bot once and it will
# tell you your ID if this is empty. NOBODY else can use the bot.
OWNER_IDS=

# Directory Claude works in by default (change at runtime with /cwd)
CLAUDE_CWD=/home/ubuntu

# Whisper model for voice transcription: tiny | base | small | medium
WHISPER_MODEL=small

# Piper TTS voice for spoken replies
PIPER_VOICE=en_US-lessac-medium
