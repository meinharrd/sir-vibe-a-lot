# Get a token from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# Your Telegram user ID(s), comma separated. Message the bot once and it will
# tell you your ID if this is empty. NOBODY else can use the bot.
OWNER_IDS=

# Directory Claude works in by default (change at runtime with /cwd)
CLAUDE_CWD=/home/ubuntu

# Whisper model for voice transcription: tiny | base | small | medium
WHISPER_MODEL=small

# Piper TTS voice for spoken replies
PIPER_VOICE=en_US-lessac-medium

# Optional: receive updates by webhook instead of polling. While a webhook is
# set, Telegram refuses getUpdates from anyone, so a leaked token can't read
# the bot's messages. Needs an https reverse proxy (e.g. Caddy) forwarding
# WEBHOOK_URL's path to 127.0.0.1:WEBHOOK_PORT. Use a random path and secret:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# WEBHOOK_URL=https://your.host/tg/<random path>
# WEBHOOK_SECRET=<random secret, A-Z a-z 0-9 _ ->
# WEBHOOK_PORT=8350
